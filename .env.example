# Root environment reference for the AI-Powered Personalized Learning Assistant
# This file documents ALL environment variables used across the project.
# In practice, copy the relevant variables into:
#   backend/.env   -> ANTHROPIC_API_KEY, MONGO_URI, PORT, CLIENT_ORIGIN
#   frontend/.env  -> VITE_API_BASE_URL

# ---------- Backend (backend/.env) ----------

# Anthropic Claude API key. Get one at https://console.anthropic.com/
# If left empty, the backend automatically runs in DEMO MODE and returns
# realistic, well-crafted canned responses for every AI feature instead of failing.
ANTHROPIC_API_KEY=

# MongoDB connection string (optional). If unset or unreachable, the backend
# logs a warning and continues running using in-memory/demo data — it never crashes.
MONGO_URI=mongodb://localhost:27017/ai-learning-assistant

# Port for the Express backend server
PORT=5000

# Allowed CORS origin(s) for the frontend dev server
CLIENT_ORIGIN=http://localhost:5173

# ---------- Frontend (frontend/.env) ----------

# Base URL the frontend uses to call the backend API
VITE_API_BASE_URL=http://localhost:5000/api
