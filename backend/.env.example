# Backend environment variables
# Copy this file to .env and fill in your values

# Google Gemini API key. If left empty, the backend runs in DEMO MODE
# and returns realistic canned AI responses instead of calling the real API.
# Get one free at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# MongoDB connection string. If left empty or unreachable, the backend
# runs without a database and uses in-memory/demo data instead of crashing.
MONGO_URI=mongodb://localhost:27017/ai-learning-assistant

# Port the Express server listens on
PORT=5000

# Comma-separated list of allowed CORS origins (frontend dev server)
CLIENT_ORIGIN=http://localhost:5173
